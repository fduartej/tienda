@using apptienda.Models
@{
    ViewData["Title"] = "Recomendados";


    var ProductosComprados = (List<Producto>)ViewData["productosComprados"];
    var ProductRatings = (List<(int productId, float score)>) ViewData["ratings"];
    var ProductoRecomendados = (List<Producto>)ViewData["GetProductRecomendados"];
}

@if (TempData["RetrainMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["RetrainMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Retrain" method="post" class="mb-3">
    <button type="submit" class="btn btn-warning">
        &#128260; Reentrenar modelo con datos reales
    </button>
</form>

<h1>Recien Comprados </h1>
  <div class="container">
    <div class="row">
      <div class="col">
        <div id="products" class="mb-3">
          <div class="row">
            @foreach (var item in ProductosComprados) {
            <div class="col-sm-4">
              <div class="card mb-3">
                <div class="card-body">
                  <div class="card-img-actions">
                      <img src="@item.ImageURL" class="d-block w-100 image-fit">
                  </div>
                </div>
                <div class="card-body">
                  <h5 class="card-title">@Html.DisplayFor(modelItem => item.Name)</h5>
                  <p class="card-text">@Html.DisplayFor(modelItem => item.Price)</p>
                </div>
              </div>
            </div>
            }
         </div>
        </div>
      </div>
    </div>
  </div>
 <hr />
<h1>Recomendados </h1>
  <div class="container">
    <div class="row">
      <div class="col">
        <div id="products" class="mb-3">
          <div class="row">
            @foreach (var item in ProductoRecomendados) {
            <div class="col-sm-4">
              <div class="card mb-3">
                <div class="card-body">
                  <div class="card-img-actions">
                      <img src="@item.ImageURL" class="d-block w-100 image-fit">
                  </div>
                </div>
                <div class="card-body">
                  <h5 class="card-title">@Html.DisplayFor(modelItem => item.Name)</h5>
                  <p class="card-text">@Html.DisplayFor(modelItem => item.Price)</p>
                    @{
                        foreach ((int productId, float normalizedScore) in ProductRatings)
                        {
                            if (productId == item.Id)
                            {
                                string formatted;
                                Console.WriteLine("Normalized Score: " + normalizedScore);
                                if (float.IsNaN(normalizedScore) || float.IsInfinity(normalizedScore))
                                {
                                    formatted = "0%";
                                }
                                else
                                {
                                    formatted = normalizedScore.ToString("0.##") + "%";
                                }
                                <span class="glyphicon glyphicon-fire"></span>@formatted;
                            }
                        }
                    }
                </div>
              </div>
            </div>
            }
         </div>
        </div>
      </div>
    </div>
  </div>