@using apptienda.Models
@{
    ViewData["Title"] = "Dashboard de Comentarios";
    var comentarios = (List<Contacto>)ViewData["Comentarios"];
    int positivos = (int)ViewData["Positivos"];
    int negativos = (int)ViewData["Negativos"];
    float promedioPos = (float)ViewData["PromedioPositivo"];
    float promedioNeg = (float)ViewData["PromedioNegativo"];
    int total = comentarios.Count;
}

<h2 class="mb-4">Dashboard de Sentimientos — últimos 30 comentarios</h2>

<!-- Tarjetas resumen -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-secondary">
            <div class="card-body text-center">
                <h5 class="card-title">Total</h5>
                <p class="display-4 mb-0">@total</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body text-center">
                <h5 class="card-title">Positivos</h5>
                <p class="display-4 mb-0">@positivos</p>
                <small>Promedio: @promedioPos.ToString("0.00")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body text-center">
                <h5 class="card-title">Negativos</h5>
                <p class="display-4 mb-0">@negativos</p>
                <small>Promedio: @promedioNeg.ToString("0.00")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body text-center">
                <h5 class="card-title">% Positivos</h5>
                @{ float pct = total > 0 ? (positivos * 100f / total) : 0f; }
                <p class="display-4 mb-0">@pct.ToString("0")%</p>
            </div>
        </div>
    </div>
</div>

<!-- Gráfico de barras -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Distribución de sentimientos</div>
            <div class="card-body">
                <canvas id="chartSentimientos" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Puntuación promedio por sentimiento</div>
            <div class="card-body">
                <canvas id="chartPromedio" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de comentarios -->
<div class="card">
    <div class="card-header">Detalle de comentarios</div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Mensaje</th>
                    <th>Sentimiento</th>
                    <th>Puntuación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in comentarios)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.Nombres</td>
                        <td>@c.Email</td>
                        <td style="max-width:300px; word-wrap:break-word;">@c.Mensaje</td>
                        <td>
                            @if (c.Etiqueta == "Positivo")
                            {
                                <span class="badge bg-success">&#128512; Positivo</span>
                            }
                            else if (c.Etiqueta == "Negativo")
                            {
                                <span class="badge bg-danger">&#128545; Negativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Sin clasificar</span>
                            }
                        </td>
                        <td>
                            <div class="progress" style="min-width:80px">
                                @{
                                    int pctBar = (int)(c.Puntuacion * 100);
                                    string barColor = c.Etiqueta == "Positivo" ? "bg-success" : "bg-danger";
                                }
                                <div class="progress-bar @barColor" style="width:@pctBar%">
                                    @c.Puntuacion.ToString("0.00")
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        // Gráfico pie positivo/negativo
        new Chart(document.getElementById('chartSentimientos'), {
            type: 'doughnut',
            data: {
                labels: ['Positivos', 'Negativos'],
                datasets: [{
                    data: [@positivos, @negativos],
                    backgroundColor: ['#198754', '#dc3545']
                }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });

        // Gráfico barras promedio
        new Chart(document.getElementById('chartPromedio'), {
            type: 'bar',
            data: {
                labels: ['Positivos', 'Negativos'],
                datasets: [{
                    label: 'Puntuación promedio',
                    data: [@promedioPos.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture),
                           @promedioNeg.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture)],
                    backgroundColor: ['#198754', '#dc3545']
                }]
            },
            options: {
                scales: { y: { min: 0, max: 1 } },
                plugins: { legend: { display: false } }
            }
        });
    </script>
}
